
{
  "globalHeaders": {
    "Cache-Control": "no-store"
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/api/*",
      "/backend/*",
      "/auth-backend/*"
    ]
  }
}
